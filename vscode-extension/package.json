{
  "name": "codeguard-safety-gate",
  "displayName": "CodeGuard (Code Kavach)",
  "description": "Deterministic Pre-Execution Safety Firewall for AI-Generated Code",
  "version": "1.0.0",
  "publisher": "codeguard",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeguard/codeguard"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Security"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:shellscript",
    "onLanguage:sql",
    "onLanguage:yaml",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeguard.scanCurrentFile",
        "title": "CodeGuard: Scan Active File",
        "icon": "$(shield)"
      },
      {
        "command": "codeguard.showStatusDetails",
        "title": "CodeGuard: Show Safety Gate Details"
      },
      {
        "command": "codeguard.toggleSync",
        "title": "CodeGuard: Toggle Live Dashboard Sync"
      }
    ],
    "configuration": {
      "title": "CodeGuard",
      "properties": {
        "codeguard.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "CodeGuard Backend Server URL"
        },
        "codeguard.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files when saved"
        },
        "codeguard.scanWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Scan and alert on security issues in real-time as you type or paste"
        },
        "codeguard.typingDebounceMs": {
          "type": "number",
          "default": 400,
          "description": "Debounce delay in milliseconds before scanning typed code"
        },
        "codeguard.highlightLines": {
          "type": "boolean",
          "default": true,
          "description": "Highlight vulnerable lines with red background"
        },
        "codeguard.showPopups": {
          "type": "boolean",
          "default": true,
          "description": "Show real-time alert popups when API keys or security risks are detected"
        }
      }
    }
  }
}
